{
  "entities": {
    "QuoteRequest": {
      "title": "Quote Request",
      "description": "A request for a shipping quote from a potential customer.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Customer's full name" },
        "email": { "type": "string", "format": "email", "description": "Customer's email address" },
        "phone": { "type": "string", "description": "Customer's phone number" },
        "pickup": { "type": "string", "description": "Pickup location address" },
        "destination": { "type": "string", "description": "Delivery destination address" },
        "packageType": { "type": "string", "description": "Type of package (e.g., Parcel, Cargo)" },
        "weight": { "type": "string", "description": "Weight or size of the package" },
        "speed": { "type": "string", "description": "Delivery speed (Standard or Express)" },
        "pickupDate": { "type": "string", "format": "date", "description": "Requested pickup date" },
        "instructions": { "type": "string", "description": "Additional handling instructions" },
        "status": { "type": "string", "enum": ["pending", "contacted", "completed", "cancelled"], "description": "Current status of the request" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the request was created" }
      },
      "required": ["fullName", "email", "phone", "pickup", "destination", "packageType", "weight", "speed", "pickupDate", "status", "createdAt"]
    },
    "Enquiry": {
      "title": "General Enquiry",
      "description": "A general question or message from a user.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "phone": { "type": "string", "description": "User's phone number" },
        "subject": { "type": "string", "description": "Subject of the enquiry" },
        "message": { "type": "string", "description": "The message content" },
        "status": { "type": "string", "enum": ["new", "read", "replied", "archived"], "description": "Current status of the enquiry" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the enquiry was created" }
      },
      "required": ["fullName", "email", "phone", "subject", "message", "status", "createdAt"]
    },
    "User": {
      "title": "User Profile",
      "description": "User profile information, including roles for admin access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User's role in the system" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the user profile was created" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "ContentAsset": {
      "title": "Content Asset",
      "description": "A dynamic asset (image or text) used on the frontend.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Unique identifier for the asset (e.g., 'about_story_image')" },
        "url": { "type": "string", "description": "URL of the image or asset" },
        "alt": { "type": "string", "description": "Alt text for accessibility" },
        "section": { "type": "string", "description": "The page or section this asset belongs to" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["key", "url", "section", "updatedAt"]
    },
    "SliderImage": {
      "title": "Slider Image",
      "description": "An image used in the operations slider.",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "URL of the slider image" },
        "title": { "type": "string", "description": "Title or caption for the image" },
        "order": { "type": "integer", "description": "Display order" },
        "active": { "type": "boolean", "description": "Whether the image is currently active" }
      },
      "required": ["url", "title", "order", "active"]
    }
  },
  "firestore": {
    "/quotes/{quoteId}": {
      "schema": "QuoteRequest",
      "description": "Collection of shipping quote requests."
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Collection of general enquiries."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/content/{contentId}": {
      "schema": "ContentAsset",
      "description": "Dynamic content assets for the frontend."
    },
    "/slider_images/{imageId}": {
      "schema": "SliderImage",
      "description": "Images for the operations slider."
    }
  }
}
